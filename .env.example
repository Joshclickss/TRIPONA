# TRIPONA Universal Cloud & Environment Configuration Template

# Server / Backend API
PORT=5088
CLIENT_URL=http://localhost:5173

# AI Travel Planner Engine (Google Gemini API - Free Tier)
GEMINI_API_KEY=

# Supabase Cloud PostgreSQL, Auth & Storage (Free Tier)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional Legacy MongoDB (Local dev fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/tripona

# Optional Firebase (if dual-auth active)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
